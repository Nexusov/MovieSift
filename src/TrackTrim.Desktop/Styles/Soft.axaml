<!-- Rounded Soft interaction patterns adapted from Filee (MIT); see third-party notices. -->
<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <CornerRadius x:Key="TTPanelRadius">16</CornerRadius>
    <CornerRadius x:Key="TTControlRadius">9</CornerRadius>
    <BackEaseOut x:Key="TTPressEase" />
    <BoxShadows x:Key="TTPanelShadow">0 2 8 0 #10000000</BoxShadows>
  </Styles.Resources>
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource TTWindowBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TTTextBrush}" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="TextBlock.heading">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource TTMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="{DynamicResource TTErrorBrush}" />
  </Style>
  <Style Selector="TextBlock.warning">
    <Setter Property="Foreground" Value="{DynamicResource TTWarningBrush}" />
  </Style>
  <Style Selector="Border.panel, Border.card">
    <Setter Property="Background" Value="{DynamicResource TTPanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TTBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource TTPanelRadius}" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="BoxShadow" Value="{StaticResource TTPanelShadow}" />
  </Style>
  <Style Selector="Border.secondary, Border.badge">
    <Setter Property="Background" Value="{DynamicResource TTSecondaryBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource TTControlRadius}" />
    <Setter Property="Padding" Value="8,4" />
  </Style>
  <Style Selector="Button">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="CornerRadius" Value="{StaticResource TTControlRadius}" />
    <Setter Property="Background" Value="{DynamicResource TTSecondaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TTTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TTBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource TTPressDuration}" Easing="{StaticResource TTPressEase}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button:pressed">
    <Setter Property="RenderTransform" Value="scale(0.95)" />
  </Style>
  <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Transitions">
      <Transitions><BrushTransition Property="Background" Duration="{DynamicResource TTHoverDuration}" /></Transitions>
    </Setter>
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TTSelectionBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TTTextBrush}" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TTSecondaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TTTextBrush}" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource TTAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TTOnAccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TTAccentBrush}" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TTAccentHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TTOnAccentBrush}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TTAccentPressedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TTOnAccentBrush}" />
  </Style>
  <Style Selector="Button:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource TTFocusBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="{DynamicResource TTErrorBrush}" />
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource TTMutedBrush}" />
    <Setter Property="Background" Value="{DynamicResource TTSecondaryBrush}" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="TextBox, ComboBox">
    <Setter Property="CornerRadius" Value="{StaticResource TTControlRadius}" />
    <Setter Property="Foreground" Value="{DynamicResource TTTextBrush}" />
    <Setter Property="Background" Value="{DynamicResource TTPanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TTBorderBrush}" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="CaretBrush" Value="{DynamicResource TTTextBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource TTAccentBrush}" />
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource TTOnAccentBrush}" />
  </Style>
  <Style Selector="TextBox:focus, ComboBox:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource TTFocusBrush}" />
  </Style>
  <Style Selector="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource TTTextBrush}" />
  </Style>
  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBoxItem, MenuItem, ComboBoxItem">
    <Setter Property="CornerRadius" Value="{StaticResource TTControlRadius}" />
    <Setter Property="Foreground" Value="{DynamicResource TTTextBrush}" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TTSelectionBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TTTextBrush}" />
  </Style>
  <Style Selector="MenuFlyoutPresenter, ToolTip">
    <Setter Property="Background" Value="{DynamicResource TTPanelBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TTTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TTBorderBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource TTControlRadius}" />
  </Style>
  <Style Selector="ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource TTAccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource TTSecondaryBrush}" />
    <Setter Property="MinHeight" Value="6" />
    <Setter Property="CornerRadius" Value="{StaticResource TTControlRadius}" />
  </Style>
  <Style Selector="Border.dropTarget">
    <Setter Property="Background" Value="{DynamicResource TTPanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TTBorderBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="{StaticResource TTPanelRadius}" />
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Transitions">
      <Transitions><TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource TTDropDuration}" Easing="CubicEaseOut" /></Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.dropTarget.drag-over">
    <Setter Property="BorderBrush" Value="{DynamicResource TTFocusBrush}" />
    <Setter Property="Background" Value="{DynamicResource TTSelectionBrush}" />
    <Setter Property="RenderTransform" Value="scale(1.015)" />
  </Style>
  <Style Selector="Window.reduced-motion Button, Window.reduced-motion Border.dropTarget">
    <Setter Property="Transitions" Value="{x:Null}" />
  </Style>
  <Style Selector="Window.reduced-motion Button:pressed, Window.reduced-motion Border.dropTarget.drag-over">
    <Setter Property="RenderTransform" Value="none" />
  </Style>
</Styles>
