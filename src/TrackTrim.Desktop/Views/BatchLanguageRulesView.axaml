<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="using:TrackTrim.Desktop.ViewModels"
             x:Class="TrackTrim.Desktop.Views.BatchLanguageRulesView"
             x:DataType="viewModels:BatchLanguageRulesViewModel">
  <Border Padding="12" BorderThickness="1" CornerRadius="4" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
    <StackPanel Spacing="8">
      <TextBlock Text="{Binding Localization[RuleHeading]}" FontWeight="SemiBold" />
      <TextBlock Text="{Binding Localization[RuleHint]}" TextWrapping="Wrap" />
      <CheckBox x:Name="AudioLanguageRuleCheckBox" Content="{Binding Localization[RuleAudio]}"
                IsChecked="{Binding AudioRuleEnabled, Mode=TwoWay}" IsEnabled="{Binding CanConfigure}" />
      <TextBox x:Name="AudioRuleLanguagesTextBox" Text="{Binding AudioLanguages, Mode=TwoWay}"
               IsEnabled="{Binding CanEditAudioLanguages}" PlaceholderText="en, rus, de-DE"
               AutomationProperties.Name="{Binding Localization[RuleAudioCodes]}" />
      <CheckBox x:Name="AudioTitleFilterCheckBox" Content="{Binding Localization[RuleAudioTitleFilter]}"
                IsChecked="{Binding AudioTitleFilterEnabled, Mode=TwoWay}" IsEnabled="{Binding CanEditAudioLanguages}" />
      <TextBox x:Name="AudioTitleContainsTextBox" Text="{Binding AudioTitleContains, Mode=TwoWay}"
               IsEnabled="{Binding CanEditAudioTitle}" AutomationProperties.Name="{Binding Localization[RuleAudioTitleContains]}" />
      <CheckBox x:Name="SubtitleLanguageRuleCheckBox" Content="{Binding Localization[RuleSubtitles]}"
                IsChecked="{Binding SubtitleRuleEnabled, Mode=TwoWay}" IsEnabled="{Binding CanConfigure}" />
      <TextBox x:Name="SubtitleRuleLanguagesTextBox" Text="{Binding SubtitleLanguages, Mode=TwoWay}"
               IsEnabled="{Binding CanEditSubtitleLanguages}" PlaceholderText="ru, en-US, sr-Latn"
               AutomationProperties.Name="{Binding Localization[RuleSubtitleCodes]}" />
      <CheckBox x:Name="SubtitleTitleFilterCheckBox" Content="{Binding Localization[RuleSubtitleTitleFilter]}"
                IsChecked="{Binding SubtitleTitleFilterEnabled, Mode=TwoWay}" IsEnabled="{Binding CanEditSubtitleLanguages}" />
      <TextBox x:Name="SubtitleTitleContainsTextBox" Text="{Binding SubtitleTitleContains, Mode=TwoWay}"
               IsEnabled="{Binding CanEditSubtitleTitle}" AutomationProperties.Name="{Binding Localization[RuleSubtitleTitleContains]}" />
      <CheckBox x:Name="SubtitleForcedOnlyCheckBox" Content="{Binding Localization[RuleForcedSubtitlesOnly]}"
                IsChecked="{Binding KeepOnlyForcedSubtitles, Mode=TwoWay}" IsEnabled="{Binding CanEditSubtitleLanguages}" />
      <TextBlock Text="{Binding Localization[RuleForcedSubtitleHelp]}" TextWrapping="Wrap" Opacity="0.8" />
      <TextBlock Text="{Binding Localization[RuleTagHelp]}" TextWrapping="Wrap" Opacity="0.8" />
      <TextBlock Text="{Binding Localization[RuleTitleHelp]}" TextWrapping="Wrap" Opacity="0.8" />
      <WrapPanel>
        <Button x:Name="PreviewLanguageRulesButton" Content="{Binding Localization[RulePreview]}" Command="{Binding PreviewCommand}" Margin="0,0,8,8" />
        <Button x:Name="ApplyLanguageRulesButton" Content="{Binding Localization[RuleApply]}" Command="{Binding ApplyCommand}" Margin="0,0,8,8" />
        <Button Content="{Binding Localization[RuleDismiss]}" Command="{Binding DismissCommand}" Margin="0,0,8,8" />
      </WrapPanel>
      <TextBlock x:Name="LanguageRuleStatusText" Text="{Binding StatusText}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" Foreground="{DynamicResource TTErrorBrush}" IsVisible="{Binding HasError}" />
      <ScrollViewer MaxHeight="340" IsVisible="{Binding HasPreview}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Files}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="viewModels:LanguageRuleFilePreviewViewModel">
              <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" Padding="0,10" Margin="0,4">
                <StackPanel Spacing="6">
                  <TextBlock Text="{Binding SourcePath}" TextWrapping="Wrap" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding StateText}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding IssuesText}" TextWrapping="Wrap" IsVisible="{Binding HasIssues}" />
                  <TextBlock Text="{Binding NoSubtitleMatchesText}" TextWrapping="Wrap" IsVisible="{Binding NoSubtitleMatches}" />
                  <TextBlock Text="{Binding ChoicesHeading}" IsVisible="{Binding HasTracks}" />
                  <TextBlock Text="{Binding ChoicesText}" TextWrapping="Wrap" IsVisible="{Binding HasTracks}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </StackPanel>
  </Border>
</UserControl>
