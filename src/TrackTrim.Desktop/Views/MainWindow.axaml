<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:appearance="using:TrackTrim.Desktop.Appearance"
        xmlns:viewModels="using:TrackTrim.Desktop.ViewModels"
        xmlns:views="using:TrackTrim.Desktop.Views"
        x:Class="TrackTrim.Desktop.Views.MainWindow"
        x:DataType="viewModels:MainViewModel"
        Title="TrackTrim" Width="1040" Height="800" MinWidth="640" MinHeight="480">
  <DockPanel Margin="16" LastChildFill="True">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Border CornerRadius="9" Background="{DynamicResource TTAccentBrush}" Width="38" Height="38">
          <TextBlock Text="TT" Foreground="{DynamicResource TTOnAccentBrush}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Spacing="2">
          <TextBlock Text="TrackTrim" FontSize="20" FontWeight="Bold" />
          <TextBlock Text="{Binding Localization[AppSubtitle]}" Classes="muted" FontSize="12" />
        </StackPanel>
      </StackPanel>
      <Button Grid.Column="1" Content="{Binding Localization[WorkspaceSettings]}" Command="{Binding ToggleAppearanceCommand}" VerticalAlignment="Center" />
    </Grid>
    <Border DockPanel.Dock="Top" Padding="12" BorderBrush="{DynamicResource TTWarningBrush}" BorderThickness="1" CornerRadius="9"
            Margin="0,0,0,16" IsVisible="{Binding HasWarningCloseDecision}">
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding Localization[CloseWarningReview]}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding WarningCloseSource}" TextWrapping="Wrap" />
        <WrapPanel>
          <Button x:Name="RemainInWarningReviewButton" Content="{Binding Localization[RemainInWarningReview]}"
                  Command="{Binding RemainInWarningReviewCommand}" Margin="0,0,8,8" />
          <Button x:Name="DiscardWarningsAndCloseButton" Content="{Binding Localization[DiscardWarningsAndClose]}"
                  Click="OnDiscardWarningsAndClose" IsEnabled="{Binding CanRespondToWarningClose}" Margin="0,0,8,8" />
        </WrapPanel>
      </StackPanel>
    </Border>
    <Border DockPanel.Dock="Top" Margin="0,0,0,12" Padding="12" BorderBrush="{DynamicResource TTWarningBrush}" BorderThickness="1" CornerRadius="9"
            IsVisible="{Binding RequiresCloseDecision}">
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding CloseDecisionText}" TextWrapping="Wrap" />
        <Button x:Name="CloseDespiteUncertaintyButton" Click="OnCloseDespiteUncertainty" Content="{Binding Localization[CloseDespiteUncertainty]}" />
      </StackPanel>
    </Border>
    <Border DockPanel.Dock="Top" Padding="12" BorderBrush="{DynamicResource TTWarningBrush}" BorderThickness="1" CornerRadius="9"
            Margin="0,0,0,12" IsVisible="{Binding PersistenceFailed}">
      <TextBlock Text="{Binding Localization[PersistenceFailure]}" TextWrapping="Wrap" />
    </Border>
    <Border DockPanel.Dock="Top" Padding="12" BorderBrush="{DynamicResource TTWarningBrush}" BorderThickness="1" CornerRadius="9"
            Margin="0,0,0,12" IsVisible="{Binding HasInterrupted}">
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding Localization[Interrupted]}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding InterruptedDetails}" TextWrapping="Wrap" />
        <Button Content="{Binding Localization[CleanInterrupted]}" Command="{Binding CleanInterruptedCommand}" IsVisible="{Binding HasCleanableInterrupted}" />
      </StackPanel>
    </Border>
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,12" IsVisible="{Binding HasCleanupIssue}">
      <TextBlock Text="{Binding Localization[CleanupHeading]}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
      <Expander Header="{Binding Localization[Diagnostics]}" IsVisible="{Binding HasDiagnostics}">
        <TextBox Text="{Binding Diagnostics}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="180" />
      </Expander>
    </StackPanel>
    <Border DockPanel.Dock="Top" Margin="0,0,0,12" IsVisible="{Binding Batch.Recovery.HasNotice}">
      <views:QueueRecoveryView DataContext="{Binding Batch.Recovery}" />
    </Border>
    <Grid>
      <views:BatchView x:Name="Workspace" DataContext="{Binding Batch}" />
      <Border Classes="panel" appearance:SoftMotion.Enter="True" IsVisible="{Binding IsAppearanceOpen}" HorizontalAlignment="Right" Width="460" MaxWidth="600" Margin="0,0,0,6" BoxShadow="{StaticResource TTPanelShadow}">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <TextBlock Text="{Binding Localization[WorkspaceSettings]}" Classes="heading" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="{Binding Localization[WorkspaceClose]}" Command="{Binding ToggleAppearanceCommand}" />
          </Grid>
          <Border DockPanel.Dock="Top" Classes="secondary" IsVisible="{Binding HasPendingMediaDecision}" Margin="0,0,0,10">
            <TextBlock Text="{Binding Localization[AppearancePendingDecision]}" Foreground="{DynamicResource TTWarningBrush}" TextWrapping="Wrap" />
          </Border>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">
              <TextBlock Text="{Binding Localization[Language]}" FontWeight="SemiBold" />
              <WrapPanel>
                <Button x:Name="EnglishButton" Content="English" Command="{Binding ChangeLanguageCommand}" CommandParameter="en" Margin="0,0,8,0" />
                <Button x:Name="RussianButton" Content="Русский" Command="{Binding ChangeLanguageCommand}" CommandParameter="ru" />
              </WrapPanel>
              <views:AppearanceView DataContext="{Binding Appearance}" />
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
