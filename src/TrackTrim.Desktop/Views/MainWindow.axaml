<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="using:TrackTrim.Desktop.ViewModels"
        xmlns:views="using:TrackTrim.Desktop.Views"
        x:Class="TrackTrim.Desktop.Views.MainWindow"
        x:DataType="viewModels:MainViewModel"
        Title="TrackTrim" Width="1040" Height="800" MinWidth="640" MinHeight="480">
  <DockPanel Margin="24" LastChildFill="True">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
      <StackPanel Spacing="4">
        <TextBlock Text="TrackTrim" FontSize="28" FontWeight="Bold" />
        <TextBlock Text="{Binding Localization[AppSubtitle]}" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="4" Margin="20,0,0,0">
        <TextBlock Text="{Binding Localization[Language]}" />
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button x:Name="EnglishButton" Content="English" Command="{Binding ChangeLanguageCommand}" CommandParameter="en" />
          <Button x:Name="RussianButton" Content="Русский" Command="{Binding ChangeLanguageCommand}" CommandParameter="ru" />
        </StackPanel>
      </StackPanel>
    </Grid>
    <Border DockPanel.Dock="Top" Padding="12" BorderBrush="Orange" BorderThickness="1" CornerRadius="4"
            Margin="0,0,0,16" IsVisible="{Binding HasWarningCloseDecision}">
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding Localization[CloseWarningReview]}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding WarningCloseSource}" TextWrapping="Wrap" />
        <WrapPanel>
          <Button x:Name="RemainInWarningReviewButton" Content="{Binding Localization[RemainInWarningReview]}"
                  Command="{Binding RemainInWarningReviewCommand}" Margin="0,0,8,8" />
          <Button x:Name="DiscardWarningsAndCloseButton" Content="{Binding Localization[DiscardWarningsAndClose]}"
                  Click="OnDiscardWarningsAndClose" IsEnabled="{Binding CanRespondToWarningClose}" Margin="0,0,8,8" />
        </WrapPanel>
      </StackPanel>
    </Border>
    <Border DockPanel.Dock="Top" Margin="0,0,0,12" Padding="12" BorderBrush="Orange" BorderThickness="1" CornerRadius="4"
            IsVisible="{Binding RequiresCloseDecision}">
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding CloseDecisionText}" TextWrapping="Wrap" />
        <Button x:Name="CloseDespiteUncertaintyButton" Click="OnCloseDespiteUncertainty" Content="{Binding Localization[CloseDespiteUncertainty]}" />
      </StackPanel>
    </Border>
    <Border DockPanel.Dock="Top" Padding="12" BorderBrush="Orange" BorderThickness="1" CornerRadius="4"
            Margin="0,0,0,12" IsVisible="{Binding PersistenceFailed}">
      <TextBlock Text="{Binding Localization[PersistenceFailure]}" TextWrapping="Wrap" />
    </Border>
    <Border DockPanel.Dock="Top" Padding="12" BorderBrush="Orange" BorderThickness="1" CornerRadius="4"
            Margin="0,0,0,12" IsVisible="{Binding HasInterrupted}">
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding Localization[Interrupted]}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding InterruptedDetails}" TextWrapping="Wrap" />
        <Button Content="{Binding Localization[CleanInterrupted]}" Command="{Binding CleanInterruptedCommand}" IsVisible="{Binding HasCleanableInterrupted}" />
      </StackPanel>
    </Border>
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,12" IsVisible="{Binding HasCleanupIssue}">
      <TextBlock Text="{Binding Localization[CleanupHeading]}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
      <Expander Header="{Binding Localization[Diagnostics]}" IsVisible="{Binding HasDiagnostics}">
        <TextBox Text="{Binding Diagnostics}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="180" />
      </Expander>
    </StackPanel>
    <Border DockPanel.Dock="Top" Margin="0,0,0,12" IsVisible="{Binding Batch.Recovery.HasNotice}">
      <views:QueueRecoveryView DataContext="{Binding Batch.Recovery}" />
    </Border>
    <views:BatchView x:Name="Workspace" DataContext="{Binding Batch}" />
  </DockPanel>
</Window>
