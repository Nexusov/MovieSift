<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="using:TrackTrim.Desktop.ViewModels"
             xmlns:views="using:TrackTrim.Desktop.Views"
             x:Class="TrackTrim.Desktop.Views.BatchView"
             x:DataType="viewModels:BatchViewModel">
  <DockPanel LastChildFill="True">
    <StackPanel x:Name="BatchRunControls" DockPanel.Dock="Bottom" Spacing="6" Margin="0,12,0,0">
      <TextBlock x:Name="BatchStatusText" Text="{Binding StatusText}" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock Text="{Binding PauseText}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding CurrentItemText}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding CurrentItemText}" />
      <TextBlock Text="{Binding StageText}" TextWrapping="Wrap" />
      <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressValue}" IsIndeterminate="{Binding IsProgressIndeterminate}" IsVisible="{Binding IsBusy}" />
      <WrapPanel>
        <Button x:Name="NewBatchButton" Content="{Binding Localization[BatchNew]}" Command="{Binding NewBatchCommand}" Margin="0,0,8,8" />
        <Button x:Name="StartBatchButton" Content="{Binding Localization[BatchStart]}" Command="{Binding RunCommand}" Margin="0,0,8,8" />
        <Button Content="{Binding Localization[BatchPauseAfterCurrent]}" Command="{Binding PauseCommand}" Margin="0,0,8,8" />
        <Button x:Name="CancelBatchButton" Content="{Binding Localization[BatchCancel]}" Command="{Binding CancelCommand}" Margin="0,0,8,8" />
      </WrapPanel>
      <Border x:Name="NewBatchConfirmation" IsVisible="{Binding HasNewBatchConfirmation}" Padding="12" BorderThickness="1"
              BorderBrush="{DynamicResource SystemControlHighlightAccentBrush}" CornerRadius="4">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding Localization[BatchNewConfirmation]}" TextWrapping="Wrap" />
          <WrapPanel>
            <Button x:Name="ConfirmNewBatchButton" Content="{Binding Localization[BatchNewConfirm]}" Command="{Binding ConfirmNewBatchCommand}" Margin="0,0,8,8" />
            <Button x:Name="KeepCurrentBatchButton" Content="{Binding Localization[BatchKeepCurrent]}" Command="{Binding KeepCurrentBatchCommand}" Margin="0,0,8,8" />
          </WrapPanel>
        </StackPanel>
      </Border>
    </StackPanel>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="12" Margin="0,12,0,0">
        <TextBlock Text="{Binding Localization[BatchInstructions]}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding LimitsText}" TextWrapping="Wrap" Opacity="0.8" />
        <WrapPanel>
          <Button x:Name="AddBatchFilesButton" Content="{Binding Localization[BatchAddFiles]}" Command="{Binding AddFilesCommand}" Margin="0,0,8,8" />
          <Button x:Name="AddBatchFolderButton" Content="{Binding Localization[BatchAddFolder]}" Command="{Binding AddFolderCommand}" Margin="0,0,8,8" />
          <Button Content="{Binding Localization[BatchInspectPending]}" Command="{Binding InspectPendingCommand}" Margin="0,0,8,8" />
        </WrapPanel>
        <CheckBox x:Name="IncludeSubfoldersCheckBox" IsChecked="{Binding IncludeSubfolders, Mode=TwoWay}"
                  IsEnabled="{Binding CanEdit}" Content="{Binding Localization[BatchIncludeSubfolders]}" />
        <TextBlock Text="{Binding Localization[BatchFolderScopeHelp]}" TextWrapping="Wrap" Opacity="0.8" />
        <WrapPanel>
          <Button x:Name="BatchOutputFolderButton" Content="{Binding Localization[ChooseOutput]}" Command="{Binding ChooseOutputCommand}" Margin="0,0,8,8" />
          <TextBlock Text="{Binding OutputFolder}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </WrapPanel>
        <TextBlock Text="{Binding SummaryText}" TextWrapping="Wrap" />
        <TextBlock x:Name="QueueCheckpointStatus" Text="{Binding Recovery.StatusText}" TextWrapping="Wrap" />
        <Button Content="{Binding Localization[QueueReload]}" Command="{Binding Recovery.ReloadCommand}" HorizontalAlignment="Left" />
        <views:RulePresetsView DataContext="{Binding Presets}" />
        <views:BatchLanguageRulesView DataContext="{Binding LanguageRules}" />
        <TextBlock Text="{Binding Localization[BatchInclusionHint]}" TextWrapping="Wrap" Opacity="0.8" />
        <ListBox x:Name="BatchFileList" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                 Height="200" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{Binding Localization[BatchFiles]}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="viewModels:BatchItemViewModel">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="4">
                <CheckBox IsChecked="{Binding Included, Mode=TwoWay}" IsEnabled="{Binding CanChangeInclusion}"
                          Content="{Binding Localization[BatchInclude]}" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" Spacing="3">
                  <TextBlock Text="{Binding SourcePath}" TextWrapping="Wrap" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding RelativeSourcePath}" IsVisible="{Binding HasFolderOrigin}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding StateText}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding PublishedPath}" TextWrapping="Wrap" IsVisible="{Binding HasPublishedPath}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <WrapPanel>
          <Button Content="{Binding Localization[BatchRemove]}" Command="{Binding RemoveSelectedCommand}" Margin="0,0,8,8" />
          <Button Content="{Binding Localization[BatchInspectSelected]}" Command="{Binding InspectSelectedCommand}" Margin="0,0,8,8" />
        </WrapPanel>

        <ContentControl Content="{Binding SelectedItem}" HorizontalContentAlignment="Stretch">
          <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="viewModels:BatchItemViewModel">
              <Border Padding="12" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="4">
                <StackPanel Spacing="8">
                  <TextBlock Text="{Binding Localization[BatchSelectedFile]}" FontWeight="SemiBold" />
                  <TextBlock x:Name="BatchSelectedSource" Text="{Binding SourcePath}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding StateText}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Localization[Output]}" />
                  <TextBox Text="{Binding OutputPath, Mode=TwoWay}" IsEnabled="{Binding CanEditPlan}" TextWrapping="Wrap"
                           AutomationProperties.Name="{Binding Localization[Output]}" />
                  <ItemsControl ItemsSource="{Binding Tracks}" IsEnabled="{Binding CanEditPlan}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="viewModels:TrackViewModel">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,4">
                          <CheckBox IsChecked="{Binding Keep, Mode=TwoWay}" IsEnabled="{Binding IsSelectable}"
                                    Content="{Binding Localization[Keep]}" AutomationProperties.Name="{Binding KeepAccessibleName}" VerticalAlignment="Top" />
                          <StackPanel Grid.Column="1" Spacing="3">
                            <WrapPanel>
                              <TextBlock Text="{Binding KindText}" FontWeight="SemiBold" Margin="0,0,8,0" />
                              <TextBlock Text="{Binding Localization[TrackId]}" Margin="0,0,4,0" />
                              <TextBlock Text="{Binding IdentifierText}" Margin="0,0,8,0" />
                              <TextBlock Text="{Binding Track.Codec}" Margin="0,0,8,0" />
                              <TextBlock Text="{Binding LanguageText}" />
                            </WrapPanel>
                            <TextBlock Text="{Binding TitleText}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding FlagsText}" TextWrapping="Wrap" />
                            <WrapPanel IsVisible="{Binding IsAudio}">
                              <TextBlock Text="{Binding Localization[Channels]}" Margin="0,0,4,0" />
                              <TextBlock Text="{Binding ChannelsText}" />
                            </WrapPanel>
                            <TextBlock Text="{Binding Localization[AlwaysKept]}" IsVisible="{Binding IsRequired}" />
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <CheckBox IsChecked="{Binding ZeroAudioConfirmed, Mode=TwoWay}" IsVisible="{Binding NeedsZeroAudioConfirmation}" IsEnabled="{Binding CanEditPlan}">
                    <TextBlock Text="{Binding Localization[ConfirmSilent]}" TextWrapping="Wrap" />
                  </CheckBox>
                  <TextBlock Text="{Binding PlanTracksText}" TextWrapping="Wrap" IsVisible="{Binding HasPlan}" />
                  <TextBlock Text="{Binding PlanDefaultAudioText}" TextWrapping="Wrap" IsVisible="{Binding HasPlan}" />
                  <TextBlock Text="{Binding Localization[SelectionWarning]}" TextWrapping="Wrap" IsVisible="{Binding RemovesDefaultAudio}" />
                  <TextBlock Text="{Binding ErrorText}" Foreground="Crimson" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
                  <TextBlock Text="{Binding ErrorReasonText}" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
                  <TextBlock Text="{Binding PublishedPath}" TextWrapping="Wrap" IsVisible="{Binding HasPublishedPath}" />
                  <Expander Header="{Binding Localization[Diagnostics]}" IsVisible="{Binding HasDiagnostics}">
                    <TextBox Text="{Binding Diagnostics}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="200" />
                  </Expander>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>

        <Button x:Name="ApproveBatchItemButton" Content="{Binding Localization[BatchApproveItem]}" Command="{Binding ApproveSelectedCommand}" HorizontalAlignment="Left" />
        <Button x:Name="ReviewBatchButton" Content="{Binding Localization[BatchReviewRemaining]}" Command="{Binding ReviewCommand}" HorizontalAlignment="Left" />
        <Border BorderBrush="{DynamicResource SystemControlHighlightAccentBrush}" BorderThickness="1" CornerRadius="4" Padding="12" IsVisible="{Binding HasReview}">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding Localization[BatchReviewedPlans]}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ReviewText}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Localization[PreservationSummary]}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <StackPanel IsVisible="{Binding HasExcluded}" Spacing="4">
          <TextBlock Text="{Binding Localization[BatchExcluded]}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding ExcludedText}" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" Foreground="Crimson" IsVisible="{Binding HasError}" />
        <TextBlock Text="{Binding ErrorReasonText}" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
        <TextBlock Text="{Binding ReviewIssuesText}" TextWrapping="Wrap" Foreground="Crimson" IsVisible="{Binding HasError}" />
        <Border Padding="12" BorderBrush="Orange" BorderThickness="1" CornerRadius="4" IsVisible="{Binding HasWarningCandidate}">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding Localization[WarningReview]}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding CurrentItemText}" TextWrapping="Wrap" />
            <WrapPanel>
              <Button Content="{Binding Localization[PublishWarnings]}" Command="{Binding PublishWarningsCommand}" Margin="0,0,8,8" />
              <Button Content="{Binding Localization[Discard]}" Command="{Binding DiscardWarningsCommand}" Margin="0,0,8,8" />
            </WrapPanel>
            <TextBlock Text="{Binding Localization[BatchExplicitResume]}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <TextBlock Text="{Binding Localization[CleanupHeading]}" TextWrapping="Wrap" IsVisible="{Binding HasCleanupIssue}" />
        <TextBlock Text="{Binding Localization[PersistenceFailure]}" TextWrapping="Wrap" IsVisible="{Binding WritesBlocked}" />
        <Expander Header="{Binding Localization[Diagnostics]}" IsVisible="{Binding HasDiagnostics}">
          <TextBox Text="{Binding Diagnostics}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="200" />
        </Expander>
        <TextBlock Text="{Binding Localization[BatchQueuePolicy]}" TextWrapping="Wrap" Opacity="0.8" />
        <TextBlock Text="{Binding Localization[OriginalNotice]}" TextWrapping="Wrap" Opacity="0.8" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
