<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:updates="using:MovieSift.Desktop.Updates"
             x:Class="MovieSift.Desktop.Views.UpdatesView"
             x:DataType="updates:UpdatesViewModel">
  <StackPanel Spacing="12">
    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
      <Image Source="avares://MovieSift/Assets/moviesift.png" Width="42" Height="42" />
      <StackPanel Spacing="2" VerticalAlignment="Center">
        <TextBlock Text="MovieSift" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="{Binding CurrentVersionText}" Classes="muted" TextWrapping="Wrap" />
      </StackPanel>
    </StackPanel>
    <Border Classes="secondary">
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding AvailableVersionText}" IsVisible="{Binding HasUpdate}" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="UpdateStatus" Text="{Binding StatusText}" TextWrapping="Wrap" />
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsChecking}" />
        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" IsVisible="{Binding IsInstalling}" />
      </StackPanel>
    </Border>
    <TextBlock Text="{Binding Localization[UpdatesPreviousFailure]}" IsVisible="{Binding PreviousInstallFailed}" TextWrapping="Wrap" />
    <TextBlock Text="{Binding CleanupNotice}" IsVisible="{Binding HasCleanupNotice}" TextWrapping="Wrap" />
    <WrapPanel>
      <Button x:Name="CheckUpdatesButton" Content="{Binding Localization[UpdatesCheckNow]}" Command="{Binding CheckCommand}" Margin="0,0,8,8" />
      <Button Content="{Binding Localization[Cancel]}" Command="{Binding CancelCommand}" IsVisible="{Binding CanCancel}" Margin="0,0,8,8" />
    </WrapPanel>
    <Button x:Name="InstallUpdateButton" Content="{Binding Localization[UpdatesInstall]}" Command="{Binding InstallCommand}"
            IsVisible="{Binding HasUpdate}" HorizontalAlignment="Stretch" />
    <TextBlock Text="{Binding Localization[UpdatesInstallNotice]}" IsVisible="{Binding HasUpdate}" Classes="muted" TextWrapping="Wrap" />
    <TextBlock Text="{Binding Localization[UpdatesFinishWork]}" IsVisible="{Binding InstallationBlocked}" TextWrapping="Wrap" />
    <Separator Margin="0,4" />
    <CheckBox Content="{Binding Localization[UpdatesCheckOnStartup]}" IsChecked="{Binding CheckOnStartup}" IsEnabled="{Binding !IsInstalling}" />
    <TextBlock Text="{Binding Localization[UpdatesPreferenceFailed]}" IsVisible="{Binding PreferenceFailed}"
               Foreground="{DynamicResource MovieSiftWarningBrush}" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
