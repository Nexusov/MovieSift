<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:appearance="using:MovieSift.Desktop.Appearance"
             x:Class="MovieSift.Desktop.Views.AppearanceView" x:DataType="appearance:AppearanceViewModel">
  <Grid RowDefinitions="*,Auto">
  <ScrollViewer x:Name="AppearanceSettingsScroll" AllowAutoHide="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
  <StackPanel Spacing="12">
    <TextBlock Text="{Binding Localization[AppearanceTheme]}" />
    <ComboBox x:Name="AppearanceTheme" ItemsSource="{Binding ThemeOptions}" SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}" HorizontalAlignment="Stretch"
              AutomationProperties.Name="{Binding Localization[AppearanceTheme]}">
      <ComboBox.ItemTemplate><DataTemplate x:DataType="appearance:AppearanceOptionViewModel"><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
    </ComboBox>
    <TextBlock Text="{Binding Localization[AppearanceAccent]}" />
    <WrapPanel>
      <RadioButton x:Name="IndigoAccentChoice" Classes="accentChoice" GroupName="CuratedAccent"
                   IsChecked="{Binding IsIndigoAccent, Mode=OneWay}" Command="{Binding SetAccentCommand}" CommandParameter="#5B6CDA"
                   AutomationProperties.Name="{Binding Localization[AppearanceIndigo]}" Margin="0,0,6,6">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <Ellipse Width="16" Height="16" Fill="#5B6CDA" Stroke="{DynamicResource MovieSiftBorderBrush}" StrokeThickness="1" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Localization[AppearanceIndigo]}" />
        </StackPanel>
      </RadioButton>
      <RadioButton x:Name="TealAccentChoice" Classes="accentChoice" GroupName="CuratedAccent"
                   IsChecked="{Binding IsTealAccent, Mode=OneWay}" Command="{Binding SetAccentCommand}" CommandParameter="#168272"
                   AutomationProperties.Name="{Binding Localization[AppearanceTeal]}" Margin="0,0,6,6">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <Ellipse Width="16" Height="16" Fill="#168272" Stroke="{DynamicResource MovieSiftBorderBrush}" StrokeThickness="1" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Localization[AppearanceTeal]}" />
        </StackPanel>
      </RadioButton>
      <RadioButton x:Name="RoseAccentChoice" Classes="accentChoice" GroupName="CuratedAccent"
                   IsChecked="{Binding IsRoseAccent, Mode=OneWay}" Command="{Binding SetAccentCommand}" CommandParameter="#C64165"
                   AutomationProperties.Name="{Binding Localization[AppearanceRose]}" Margin="0,0,6,6">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <Ellipse Width="16" Height="16" Fill="#C64165" Stroke="{DynamicResource MovieSiftBorderBrush}" StrokeThickness="1" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Localization[AppearanceRose]}" />
        </StackPanel>
      </RadioButton>
      <RadioButton x:Name="AmberAccentChoice" Classes="accentChoice" GroupName="CuratedAccent"
                   IsChecked="{Binding IsAmberAccent, Mode=OneWay}" Command="{Binding SetAccentCommand}" CommandParameter="#A56A13"
                   AutomationProperties.Name="{Binding Localization[AppearanceAmber]}" Margin="0,0,6,6">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <Ellipse Width="16" Height="16" Fill="#A56A13" Stroke="{DynamicResource MovieSiftBorderBrush}" StrokeThickness="1" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Localization[AppearanceAmber]}" />
        </StackPanel>
      </RadioButton>
    </WrapPanel>
    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
      <ColorPicker x:Name="AppearanceAccentPicker" Color="{Binding AccentColor, Mode=TwoWay}" IsAlphaEnabled="False" IsAlphaVisible="False"
                   IsColorSpectrumVisible="True" IsColorPaletteVisible="False" IsColorComponentsVisible="False" IsColorModelVisible="False"
                   IsColorPreviewVisible="True" AutomationProperties.Name="{Binding Localization[AppearanceAccent]}" MinWidth="70" />
      <TextBox x:Name="AppearanceAccentHex" Grid.Column="1" Text="{Binding AccentHex, Mode=TwoWay}" PlaceholderText="#RRGGBB"
               AutomationProperties.Name="{Binding Localization[AppearanceAccentHex]}" />
    </Grid>
    <Expander Header="{Binding Localization[AppearanceCustomColors]}">
      <StackPanel Spacing="10">
        <TextBlock Classes="muted" Text="{Binding Localization[AppearanceCustomHelp]}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Localization[AppearanceLight]}" FontWeight="SemiBold" />
        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
          <TextBlock Text="{Binding Localization[AppearancePage]}" VerticalAlignment="Center" TextWrapping="Wrap" />
          <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <Ellipse Width="18" Height="18" Fill="{Binding LightPageBrush}" Stroke="{DynamicResource MovieSiftBorderBrush}" StrokeThickness="1" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding LightPage, Mode=TwoWay}" PlaceholderText="#RRGGBB" AutomationProperties.Name="{Binding Localization[AppearancePage]}" />
          </Grid>
          <TextBlock Grid.Row="1" Text="{Binding Localization[AppearanceSurface]}" VerticalAlignment="Center" TextWrapping="Wrap" />
          <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <Ellipse Width="18" Height="18" Fill="{Binding LightSurfaceBrush}" Stroke="{DynamicResource MovieSiftBorderBrush}" StrokeThickness="1" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding LightSurface, Mode=TwoWay}" PlaceholderText="#RRGGBB" AutomationProperties.Name="{Binding Localization[AppearanceSurface]}" />
          </Grid>
          <TextBlock Grid.Row="2" Text="{Binding Localization[AppearancePrimaryText]}" VerticalAlignment="Center" TextWrapping="Wrap" />
          <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <Ellipse Width="18" Height="18" Fill="{Binding LightTextBrush}" Stroke="{DynamicResource MovieSiftBorderBrush}" StrokeThickness="1" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding LightText, Mode=TwoWay}" PlaceholderText="#RRGGBB" AutomationProperties.Name="{Binding Localization[AppearancePrimaryText]}" />
          </Grid>
          <TextBlock Grid.Row="3" Text="{Binding Localization[AppearanceSecondaryText]}" VerticalAlignment="Center" TextWrapping="Wrap" />
          <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <Ellipse Width="18" Height="18" Fill="{Binding LightMutedBrush}" Stroke="{DynamicResource MovieSiftBorderBrush}" StrokeThickness="1" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding LightMuted, Mode=TwoWay}" PlaceholderText="#RRGGBB" AutomationProperties.Name="{Binding Localization[AppearanceSecondaryText]}" />
          </Grid>
          <TextBlock Grid.Row="4" Text="{Binding Localization[AppearanceBorder]}" VerticalAlignment="Center" TextWrapping="Wrap" />
          <Grid Grid.Row="4" Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <Ellipse Width="18" Height="18" Fill="{Binding LightBorderBrush}" Stroke="{DynamicResource MovieSiftBorderBrush}" StrokeThickness="1" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding LightBorder, Mode=TwoWay}" PlaceholderText="#RRGGBB" AutomationProperties.Name="{Binding Localization[AppearanceBorder]}" />
          </Grid>
        </Grid>
        <TextBlock Text="{Binding Localization[AppearanceDark]}" FontWeight="SemiBold" />
        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
          <TextBlock Text="{Binding Localization[AppearancePage]}" VerticalAlignment="Center" TextWrapping="Wrap" />
          <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <Ellipse Width="18" Height="18" Fill="{Binding DarkPageBrush}" Stroke="{DynamicResource MovieSiftBorderBrush}" StrokeThickness="1" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding DarkPage, Mode=TwoWay}" PlaceholderText="#RRGGBB" AutomationProperties.Name="{Binding Localization[AppearancePage]}" />
          </Grid>
          <TextBlock Grid.Row="1" Text="{Binding Localization[AppearanceSurface]}" VerticalAlignment="Center" TextWrapping="Wrap" />
          <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <Ellipse Width="18" Height="18" Fill="{Binding DarkSurfaceBrush}" Stroke="{DynamicResource MovieSiftBorderBrush}" StrokeThickness="1" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding DarkSurface, Mode=TwoWay}" PlaceholderText="#RRGGBB" AutomationProperties.Name="{Binding Localization[AppearanceSurface]}" />
          </Grid>
          <TextBlock Grid.Row="2" Text="{Binding Localization[AppearancePrimaryText]}" VerticalAlignment="Center" TextWrapping="Wrap" />
          <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <Ellipse Width="18" Height="18" Fill="{Binding DarkTextBrush}" Stroke="{DynamicResource MovieSiftBorderBrush}" StrokeThickness="1" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding DarkText, Mode=TwoWay}" PlaceholderText="#RRGGBB" AutomationProperties.Name="{Binding Localization[AppearancePrimaryText]}" />
          </Grid>
          <TextBlock Grid.Row="3" Text="{Binding Localization[AppearanceSecondaryText]}" VerticalAlignment="Center" TextWrapping="Wrap" />
          <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <Ellipse Width="18" Height="18" Fill="{Binding DarkMutedBrush}" Stroke="{DynamicResource MovieSiftBorderBrush}" StrokeThickness="1" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding DarkMuted, Mode=TwoWay}" PlaceholderText="#RRGGBB" AutomationProperties.Name="{Binding Localization[AppearanceSecondaryText]}" />
          </Grid>
          <TextBlock Grid.Row="4" Text="{Binding Localization[AppearanceBorder]}" VerticalAlignment="Center" TextWrapping="Wrap" />
          <Grid Grid.Row="4" Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <Ellipse Width="18" Height="18" Fill="{Binding DarkBorderBrush}" Stroke="{DynamicResource MovieSiftBorderBrush}" StrokeThickness="1" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding DarkBorder, Mode=TwoWay}" PlaceholderText="#RRGGBB" AutomationProperties.Name="{Binding Localization[AppearanceBorder]}" />
          </Grid>
        </Grid>
      </StackPanel>
    </Expander>
    <TextBlock Text="{Binding Localization[AppearanceMotion]}" />
    <ComboBox x:Name="AppearanceMotion" ItemsSource="{Binding MotionOptions}" SelectedIndex="{Binding MotionIndex, Mode=TwoWay}" HorizontalAlignment="Stretch"
              AutomationProperties.Name="{Binding Localization[AppearanceMotion]}">
      <ComboBox.ItemTemplate><DataTemplate x:DataType="appearance:AppearanceOptionViewModel"><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
    </ComboBox>
    <TextBlock Classes="muted" Text="{Binding MotionNotice}" TextWrapping="Wrap" />
    <TextBlock x:Name="AppearanceError" Classes="warning" Text="{Binding ErrorText}" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
    <Expander Header="{Binding Localization[Diagnostics]}" IsVisible="{Binding HasDiagnostics}">
      <TextBox Text="{Binding Diagnostics}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="120" />
    </Expander>

  </StackPanel>
  </ScrollViewer>
    <Button Grid.Row="1" Margin="0,16,0,0" x:Name="AppearanceReset" Content="{Binding Localization[AppearanceReset]}" Command="{Binding ResetCommand}" HorizontalAlignment="Left" />
  </Grid>
</UserControl>
