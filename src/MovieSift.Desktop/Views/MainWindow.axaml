<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:appearance="using:MovieSift.Desktop.Appearance"
        xmlns:viewModels="using:MovieSift.Desktop.ViewModels"
        xmlns:views="using:MovieSift.Desktop.Views"
        xmlns:converters="using:Avalonia.Data.Converters"
        x:Class="MovieSift.Desktop.Views.MainWindow"
        x:DataType="viewModels:MainViewModel"
        Title="MovieSift" Icon="avares://MovieSift/Assets/moviesift.ico" Width="1040" Height="800" MinWidth="640" MinHeight="480">
  <DockPanel Margin="16" LastChildFill="True">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto" Margin="0,0,0,12" Background="Transparent" PointerPressed="OnWindowCaptionPressed">
      <Grid x:Name="WindowDragRegion" ColumnDefinitions="Auto,*" ColumnSpacing="12" MinWidth="0">
        <Image Source="avares://MovieSift/Assets/moviesift.png" Width="38" Height="38" AutomationProperties.Name="MovieSift" />
        <StackPanel Grid.Column="1" Spacing="2" MinWidth="0" ClipToBounds="True">
          <TextBlock Text="MovieSift" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Localization[AppSubtitle]}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Grid>
      <Button x:Name="AvailableUpdateButton" Grid.Column="1" Command="{Binding UpdateActionCommand}" IsVisible="{Binding ShowUpdateAction}" VerticalAlignment="Center" Margin="0,0,8,0"
                AutomationProperties.Name="{Binding UpdateActionText}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Path Width="19" Height="19" Stretch="Uniform" Stroke="{DynamicResource MovieSiftTextBrush}" StrokeThickness="1.6"
                  StrokeLineCap="Round" StrokeJoin="Round" Data="M20,7 A8,8 0 0 0 5,6 L3,9 M3,3 V9 H9 M4,17 A8,8 0 0 0 19,18 L21,15 M15,15 H21 V21" />
            <TextBlock Text="{Binding UpdateActionText}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Button>
      <TextBlock x:Name="UpdateSummary" Grid.Column="1" Grid.Row="1" MaxWidth="180" Margin="0,3,8,0" Text="{Binding UpdateSummaryText}" IsVisible="{Binding ShowUpdateSummary}"
                   FontSize="10" Foreground="{DynamicResource MovieSiftAccentBrush}" TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding UpdateSummaryText}" />
      <Button x:Name="LanguageButton" Grid.Column="2" Command="{Binding ToggleLanguageCommand}" VerticalAlignment="Center" Margin="0,0,8,0"
              AutomationProperties.Name="{Binding Localization[LanguageTitle]}" ToolTip.Tip="{Binding Localization[LanguageTitle]}">
        <Path Width="21" Height="21" Stretch="Uniform" Stroke="{DynamicResource MovieSiftTextBrush}" StrokeThickness="1.6"
              Data="M3,5 H15 M9,2 V5 M12,5 C11,11 8,14 3,17 M5,9 C6,12 8,14 11,16 M13,21 L17.5,10 L22,21 M14.5,17 H20.5" />
      </Button>
      <Button x:Name="AppearanceButton" Grid.Column="3" Command="{Binding ToggleAppearanceCommand}" VerticalAlignment="Center"
              AutomationProperties.Name="{Binding Localization[WorkspaceSettings]}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Path Width="19" Height="19" Stretch="Uniform" Stroke="{DynamicResource MovieSiftTextBrush}" StrokeThickness="1.6"
                Data="M12,3 A9,9 0 1 0 12,21 H13 A2,2 0 0 0 14.6,17.8 A1.6,1.6 0 0 1 15.9,15.2 H18 A4,4 0 0 0 22,11.2 C22,6.8 17,3 12,3 M8,10 A1,1 0 1 1 6,10 A1,1 0 1 1 8,10 M12,7 A1,1 0 1 1 10,7 A1,1 0 1 1 12,7 M17,8 A1,1 0 1 1 15,8 A1,1 0 1 1 17,8" />
          <TextBlock Text="{Binding Localization[WorkspaceSettings]}" />
        </StackPanel>
      </Button>
      <views:WindowChrome x:Name="Caption" Grid.Column="4" Margin="8,0,0,0" VerticalAlignment="Center" />
    </Grid>
    <Border DockPanel.Dock="Top" Padding="12" BorderBrush="{DynamicResource MovieSiftWarningBrush}" BorderThickness="1" CornerRadius="9"
            Margin="0,0,0,16" IsVisible="{Binding HasWarningCloseDecision}">
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding Localization[CloseWarningReview]}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding WarningCloseSource}" TextWrapping="Wrap" />
        <WrapPanel>
          <Button x:Name="RemainInWarningReviewButton" Content="{Binding Localization[RemainInWarningReview]}"
                  Command="{Binding RemainInWarningReviewCommand}" Margin="0,0,8,8" />
          <Button x:Name="DiscardWarningsAndCloseButton" Content="{Binding Localization[DiscardWarningsAndClose]}"
                  Click="OnDiscardWarningsAndClose" IsEnabled="{Binding CanRespondToWarningClose}" Margin="0,0,8,8" />
        </WrapPanel>
      </StackPanel>
    </Border>
    <Border DockPanel.Dock="Top" Margin="0,0,0,12" Padding="12" BorderBrush="{DynamicResource MovieSiftWarningBrush}" BorderThickness="1" CornerRadius="9"
            IsVisible="{Binding RequiresCloseDecision}">
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding CloseDecisionText}" TextWrapping="Wrap" />
        <Button x:Name="CloseDespiteUncertaintyButton" Click="OnCloseDespiteUncertainty" Content="{Binding Localization[CloseDespiteUncertainty]}" />
      </StackPanel>
    </Border>
    <Border DockPanel.Dock="Top" Padding="12" BorderBrush="{DynamicResource MovieSiftWarningBrush}" BorderThickness="1" CornerRadius="9"
            Margin="0,0,0,12" IsVisible="{Binding PersistenceFailed}">
      <TextBlock Text="{Binding Localization[PersistenceFailure]}" TextWrapping="Wrap" />
    </Border>
    <Border DockPanel.Dock="Top" Padding="12" BorderBrush="{DynamicResource MovieSiftWarningBrush}" BorderThickness="1" CornerRadius="9"
            Margin="0,0,0,12" IsVisible="{Binding HasInterrupted}">
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding Localization[Interrupted]}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding InterruptedDetails}" TextWrapping="Wrap" />
        <Button Content="{Binding Localization[CleanInterrupted]}" Command="{Binding CleanInterruptedCommand}" IsVisible="{Binding HasCleanableInterrupted}" />
      </StackPanel>
    </Border>
    <Border DockPanel.Dock="Top" Padding="12" BorderBrush="{DynamicResource MovieSiftWarningBrush}" BorderThickness="1" CornerRadius="9"
            Margin="0,0,0,12" IsVisible="{Binding LanguagePreferenceFailed}">
      <TextBlock Text="{Binding Localization[LanguagePreferenceFailure]}" TextWrapping="Wrap" />
    </Border>
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,12" IsVisible="{Binding HasCleanupIssue}">
      <TextBlock Text="{Binding Localization[CleanupHeading]}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
      <Expander Header="{Binding Localization[Diagnostics]}" IsVisible="{Binding HasDiagnostics}">
        <TextBox Text="{Binding Diagnostics}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="180" />
      </Expander>
    </StackPanel>
    <Border DockPanel.Dock="Top" Margin="0,0,0,12" IsVisible="{Binding Batch.Recovery.HasNotice}">
      <views:QueueRecoveryView DataContext="{Binding Batch.Recovery}" />
    </Border>
    <Grid>
      <Border IsHitTestVisible="{Binding !#PreferencesBackdrop.IsVisible}">
        <views:BatchView x:Name="Workspace" DataContext="{Binding Batch}" />
      </Border>
      <Border x:Name="PreferencesBackdrop" Background="Transparent" PointerPressed="OnPreferencesBackdropPressed">
        <Border.IsVisible>
          <MultiBinding Converter="{x:Static converters:BoolConverters.Or}">
            <Binding Path="IsVisible" ElementName="AppearancePanel" />
            <Binding Path="IsVisible" ElementName="LanguagePanel" />
            <Binding Path="IsVisible" ElementName="UpdatesPanel" />
          </MultiBinding>
        </Border.IsVisible>
      </Border>
      <Border x:Name="AppearancePanel" Classes="panel" appearance:SoftMotion.Visible="{Binding IsAppearanceOpen}" IsHitTestVisible="{Binding IsAppearanceOpen}" KeyboardNavigation.TabNavigation="Cycle" HorizontalAlignment="Right" Width="460" MaxWidth="600" Margin="0,0,0,6" BoxShadow="{StaticResource MovieSiftPanelShadow}">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <TextBlock Text="{Binding Localization[WorkspaceSettings]}" Classes="heading" VerticalAlignment="Center" />
            <Button x:Name="CloseAppearanceButton" Grid.Column="1" Classes="iconClose" Command="{Binding ToggleAppearanceCommand}"
                    AutomationProperties.Name="{Binding Localization[WorkspaceClose]}" ToolTip.Tip="{Binding Localization[WorkspaceClose]}">
              <Path Classes="closeGlyph" />
            </Button>
          </Grid>
          <Border DockPanel.Dock="Top" Classes="secondary" IsVisible="{Binding HasPendingMediaDecision}" Margin="0,0,0,10">
            <TextBlock Text="{Binding Localization[AppearancePendingDecision]}" Foreground="{DynamicResource MovieSiftWarningBrush}" TextWrapping="Wrap" />
          </Border>
          <Border IsEnabled="{Binding CanEditPreferences}">
            <views:AppearanceView x:Name="AppearanceEditor" DataContext="{Binding Appearance}" />
          </Border>
        </DockPanel>
      </Border>
      <Border x:Name="UpdatesPanel" Classes="panel" appearance:SoftMotion.Visible="{Binding IsUpdatesOpen}" IsHitTestVisible="{Binding IsUpdatesOpen}"
              KeyboardNavigation.TabNavigation="Cycle" HorizontalAlignment="Right" Width="400" MaxHeight="{Binding #Workspace.Bounds.Height}"
              Margin="0,0,0,6" BoxShadow="{StaticResource MovieSiftPanelShadow}">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <TextBlock Text="{Binding Localization[UpdatesHeading]}" Classes="heading" VerticalAlignment="Center" />
            <Button x:Name="CloseUpdatesButton" Grid.Column="1" Classes="iconClose" Command="{Binding ToggleUpdatesCommand}"
                    AutomationProperties.Name="{Binding Localization[WorkspaceClose]}" ToolTip.Tip="{Binding Localization[WorkspaceClose]}">
              <Path Classes="closeGlyph" />
            </Button>
          </Grid>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <views:UpdatesView DataContext="{Binding Updates}" />
          </ScrollViewer>
        </DockPanel>
      </Border>
      <Border x:Name="LanguagePanel" Classes="panel" appearance:SoftMotion.Visible="{Binding IsLanguageOpen}" IsHitTestVisible="{Binding IsLanguageOpen}"
              KeyboardNavigation.TabNavigation="Cycle" HorizontalAlignment="Right" VerticalAlignment="Top" Width="380" MaxWidth="600" MaxHeight="{Binding #Workspace.Bounds.Height}"
              Margin="0,0,0,6" BoxShadow="{StaticResource MovieSiftPanelShadow}">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <TextBlock Text="{Binding Localization[LanguageTitle]}" Classes="heading" VerticalAlignment="Center" />
            <Button x:Name="CloseLanguageButton" Grid.Column="1" Classes="iconClose" Command="{Binding ToggleLanguageCommand}"
                    AutomationProperties.Name="{Binding Localization[LanguageClose]}" ToolTip.Tip="{Binding Localization[LanguageClose]}">
              <Path Classes="closeGlyph" />
            </Button>
          </Grid>
          <views:LanguagesView DataContext="{Binding Languages}" />
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
