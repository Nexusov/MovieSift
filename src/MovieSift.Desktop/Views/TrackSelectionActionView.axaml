<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:MovieSift.Desktop.Views"
             x:Class="MovieSift.Desktop.Views.TrackSelectionActionView" x:Name="ActionRoot"
             x:DataType="views:TrackSelectionActionView">
  <Button x:Name="TrackSelectionActionButton" Command="{Binding #ActionRoot.Command}" MinWidth="96" Classes.danger="{Binding !#ActionRoot.IsRestore}"
          AutomationProperties.Name="{Binding #ActionRoot.AccessibleName}" AutomationProperties.HelpText="{Binding #ActionRoot.Help}"
          ToolTip.Tip="{Binding #ActionRoot.Help}">
    <StackPanel Orientation="Horizontal" Spacing="6">
      <Path Classes="closeGlyph" Width="12" Height="12" IsVisible="{Binding !#ActionRoot.IsRestore}" />
      <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource MovieSiftTextBrush}" StrokeThickness="1.6"
            StrokeLineCap="Round" StrokeJoin="Round" IsVisible="{Binding #ActionRoot.IsRestore}"
            Data="M8,3 L3,8 L8,13 M3,8 H14 A6,6 0 0 1 14,20 H11" />
      <TextBlock Text="{Binding #ActionRoot.Text}" />
    </StackPanel>
  </Button>
</UserControl>
