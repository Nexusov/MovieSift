<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="using:MovieSift.Desktop.ViewModels"
             x:Class="MovieSift.Desktop.Views.WindowChrome"
             x:DataType="viewModels:MainViewModel" x:Name="Chrome">
  <UserControl.Styles>
    <Style Selector="Button.caption">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="RenderTransform" Value="none" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="CaptionSurface" Background="{TemplateBinding Background}">
            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.caption:pointerover /template/ Border#CaptionSurface">
      <Setter Property="Background" Value="{DynamicResource MovieSiftSelectionBrush}" />
    </Style>
    <Style Selector="Button.caption:pressed /template/ Border#CaptionSurface">
      <Setter Property="Background" Value="{DynamicResource MovieSiftSecondaryBrush}" />
    </Style>
  </UserControl.Styles>
    <StackPanel Orientation="Horizontal" Height="32">
      <Button x:Name="MinimizeButton" Classes="caption" Click="OnMinimize"
              AutomationProperties.Name="{Binding Localization[WindowMinimize]}" ToolTip.Tip="{Binding Localization[WindowMinimize]}">
        <PathIcon Width="10" Height="10" Data="M 0,4 L 10,4 L 10,5 L 0,5 Z" />
      </Button>
      <Button x:Name="MaximizeButton" Classes="caption" Click="OnMaximize"
              AutomationProperties.Name="{Binding #Chrome.MaximizeText}" ToolTip.Tip="{Binding #Chrome.MaximizeText}">
        <PathIcon x:Name="MaximizeGlyph" Width="10" Height="10" Data="M 0,0 L 10,0 L 10,10 L 0,10 Z M 1,1 L 1,9 L 9,9 L 9,1 Z" />
      </Button>
      <Button x:Name="CloseWindowButton" Classes="caption" Click="OnClose"
              AutomationProperties.Name="{Binding Localization[WindowClose]}" ToolTip.Tip="{Binding Localization[WindowClose]}">
        <Path Classes="closeGlyph" Width="12" Height="12" />
      </Button>
    </StackPanel>
</UserControl>
