<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="using:MovieSift.Desktop.ViewModels"
             xmlns:views="using:MovieSift.Desktop.Views"
             x:Class="MovieSift.Desktop.Views.AggregateTracksView"
             x:DataType="viewModels:AggregateTracksViewModel">
  <UserControl.Styles>
    <Style Selector="Border.groupCard.excluded"><Setter Property="Background" Value="{DynamicResource MovieSiftSecondaryBrush}" /></Style>
    <Style Selector="Border.groupCard.excluded StackPanel.groupMetadata TextBlock"><Setter Property="Foreground" Value="{DynamicResource MovieSiftMutedBrush}" /></Style>
    <Style Selector="Border.memberCard.excluded StackPanel.memberMetadata TextBlock"><Setter Property="Foreground" Value="{DynamicResource MovieSiftMutedBrush}" /></Style>
    <Style Selector="TextBlock.selectionState.mixed"><Setter Property="Foreground" Value="{DynamicResource MovieSiftWarningBrush}" /></Style>
    <Style Selector="ToggleButton.memberExpand PathIcon">
      <Setter Property="RenderTransform" Value="rotate(0deg)" />
    </Style>
    <Style Selector="ToggleButton.memberExpand:checked PathIcon">
      <Setter Property="RenderTransform" Value="rotate(180deg)" />
    </Style>
  </UserControl.Styles>
  <UserControl.Resources>
    <DataTemplate x:Key="AggregateGroupTemplate" x:DataType="viewModels:AggregateTrackGroupViewModel">
      <Border Classes="card groupCard" Classes.excluded="{Binding IsExcluded}" Padding="10" Margin="0,3">
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
            <StackPanel Classes="groupMetadata" Spacing="3">
              <WrapPanel>
                <TextBlock Text="{Binding KindText}" FontWeight="SemiBold" Margin="0,0,8,0" />
                <TextBlock Text="{Binding LanguageText}" FontWeight="SemiBold" Margin="0,0,8,0" />
                <TextBlock Text="{Binding TitleText}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Localization[AlwaysKept]}" Classes="muted" IsVisible="{Binding IsRequired}" Margin="8,0,0,0" />
              </WrapPanel>
              <WrapPanel>
                <TextBlock Text="{Binding CodecText}" Classes="muted" Margin="0,0,8,0" />
                <TextBlock Text="{Binding ChannelsText}" Classes="muted" Margin="0,0,8,0" />
                <TextBlock Text="{Binding CoverageText}" Classes="muted" />
              </WrapPanel>
              <TextBlock x:Name="AggregateGroupFlagsText" Text="{Binding FlagsText}" Classes="muted" TextWrapping="Wrap" />
              <TextBlock Text="{Binding ChoiceText}" Classes="muted selectionState" Classes.mixed="{Binding IsMixed}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding LanguageIssueText}" IsVisible="{Binding HasLanguageIssue}" TextWrapping="Wrap" />
            </StackPanel>
            <views:TrackSelectionActionView Grid.Column="1" VerticalAlignment="Top" IsVisible="{Binding !IsRequired}"
                Command="{Binding ToggleKeepCommand}" IsRestore="{Binding RestoresExcluded}" Text="{Binding SelectionActionText}"
                AccessibleName="{Binding SelectionActionAccessibleName}" Help="{Binding SelectionActionHelp}" />
            <PathIcon Grid.Column="1" Width="14" Height="17" Margin="8" VerticalAlignment="Top" IsVisible="{Binding IsRequired}"
                      Data="M3,7 L3,4 C3,0 11,0 11,4 L11,7 L13,7 L13,16 L1,16 L1,7 Z M5,7 L9,7 L9,4 C9,2 5,2 5,4 Z" />
            <ToggleButton Grid.Column="2" Classes="memberExpand" Width="32" Height="32" MinWidth="32" MinHeight="32" Padding="8"
                          IsChecked="{Binding IsExpanded, Mode=TwoWay}" VerticalAlignment="Top"
                          ToolTip.Tip="{Binding Localization[AggregateMembers]}" AutomationProperties.Name="{Binding MembersAccessibleName}">
              <PathIcon Width="12" Height="8" RenderTransformOrigin="50%,50%"
                        Data="M0,1.5 L1.5,0 L6,4.5 L10.5,0 L12,1.5 L6,7.5 Z" />
            </ToggleButton>
          </Grid>
          <ItemsControl ItemsSource="{Binding Members}" IsVisible="{Binding IsExpanded}" HorizontalAlignment="Stretch">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="viewModels:AggregateTrackMemberViewModel">
                <Border Classes="memberCard" Classes.excluded="{Binding IsExcluded}" Background="{DynamicResource MovieSiftSecondaryBrush}" CornerRadius="9" Padding="8" Margin="0,3">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <StackPanel Classes="memberMetadata" Spacing="3">
                      <TextBlock Text="{Binding SourcePath}" TextWrapping="Wrap" />
                      <WrapPanel>
                        <TextBlock Text="{Binding Localization[TrackId]}" Margin="0,0,4,0" />
                        <TextBlock Text="{Binding IdentifierText}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding LanguageText}" />
                      </WrapPanel>
                      <TextBlock Text="{Binding TitleText}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding FlagsText}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding SizeText}" Classes="muted" ToolTip.Tip="{Binding Localization[TrackSizeHelp]}" />
                      <TextBlock Text="{Binding StateText}" TextWrapping="Wrap" />
                    </StackPanel>
                    <views:TrackSelectionActionView Grid.Column="1" VerticalAlignment="Top" IsVisible="{Binding !IsRequired}"
                        Command="{Binding ToggleSelectionCommand}" IsRestore="{Binding IsExcluded}" Text="{Binding SelectionActionText}"
                        AccessibleName="{Binding SelectionActionAccessibleName}" />
                    <PathIcon Grid.Column="1" Width="14" Height="17" Margin="8" VerticalAlignment="Top" IsVisible="{Binding IsRequired}"
                              Data="M3,7 L3,4 C3,0 11,0 11,4 L11,7 L13,7 L13,16 L1,16 L1,7 Z M5,7 L9,7 L9,4 C9,2 5,2 5,4 Z" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>
  <StackPanel Spacing="8">
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock Text="{Binding Localization[AggregateHeading]}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
      <views:HelpHintView x:Name="GroupingHelpHint" Text="{Binding Localization[AggregateNotice]}" Label="{Binding Localization[WorkspaceGroupingHelp]}" />
    </StackPanel>
    <TextBlock x:Name="AggregateScopeText" Text="{Binding ScopeText}" Classes="muted" TextWrapping="Wrap" />
    <TextBlock Text="{Binding Localization[AggregateSelectionHelp]}" Classes="muted" TextWrapping="Wrap" />
    <StackPanel IsVisible="{Binding HasUnresolved}" Spacing="4">
      <TextBlock Text="{Binding Localization[AggregateUnresolved]}" TextWrapping="Wrap" Foreground="{DynamicResource MovieSiftErrorBrush}" />
      <TextBlock Text="{Binding UnresolvedText}" TextWrapping="Wrap" />
    </StackPanel>
    <Expander x:Name="AggregateVideoSection" Header="{Binding VideoSummaryText}" ToolTip.Tip="{Binding Localization[AlwaysKept]}"
              IsExpanded="False" HorizontalContentAlignment="Stretch">
      <ItemsControl ItemsSource="{Binding VideoGroups}" ItemTemplate="{StaticResource AggregateGroupTemplate}" />
    </Expander>
    <TabControl x:Name="AggregateTrackCategories" Classes="trackCategories" SelectedIndex="{Binding SelectedTrackTab, Mode=TwoWay}">
      <TabItem Header="{Binding Localization[Audio]}">
        <StackPanel Spacing="8">
          <TextBlock x:Name="AudioSectionHeading" Text="{Binding AudioSummaryText}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding AudioGroups}" ItemTemplate="{StaticResource AggregateGroupTemplate}" />
        </StackPanel>
      </TabItem>
      <TabItem Header="{Binding Localization[Subtitles]}">
        <StackPanel Spacing="8">
          <TextBlock x:Name="SubtitleSectionHeading" Text="{Binding SubtitleSummaryText}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <Button x:Name="RemoveAllSubtitlesButton" Content="{Binding Localization[RemoveAllSubtitles]}" Classes="danger"
                  Command="{Binding RemoveAllSubtitlesCommand}" HorizontalAlignment="Left" />
          <ItemsControl ItemsSource="{Binding SubtitleGroups}" ItemTemplate="{StaticResource AggregateGroupTemplate}" />
        </StackPanel>
      </TabItem>
    </TabControl>
  </StackPanel>
</UserControl>
