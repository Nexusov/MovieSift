<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MovieSift.Desktop.Views.HelpHintView"
             x:Name="HintRoot">
  <Button x:Name="HintButton" Classes="helpHint" Content="?" Width="24" Height="24" MinWidth="24" MinHeight="24"
          Padding="0" FontSize="12" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
          AutomationProperties.Name="{Binding #HintRoot.Label}" AutomationProperties.HelpText="{Binding #HintRoot.Text}"
          ToolTip.ShowDelay="0" ToolTip.Placement="Bottom"
          PointerEntered="OnHintPointerEntered" GotFocus="OnHintFocused" LostFocus="OnHintBlurred">
    <ToolTip.Tip>
      <TextBlock Text="{Binding #HintRoot.Text}" MaxWidth="320" TextWrapping="Wrap" />
    </ToolTip.Tip>
  </Button>
</UserControl>
