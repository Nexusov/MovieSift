<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="using:MovieSift.Desktop.ViewModels"
             xmlns:views="using:MovieSift.Desktop.Views"
             x:Class="MovieSift.Desktop.Views.FileTracksView"
             x:DataType="viewModels:BatchItemViewModel">
  <UserControl.Styles>
    <Style Selector="Border.trackCard.excluded"><Setter Property="Background" Value="{DynamicResource MovieSiftSecondaryBrush}" /></Style>
    <Style Selector="Border.trackCard.excluded StackPanel.trackMetadata TextBlock"><Setter Property="Foreground" Value="{DynamicResource MovieSiftMutedBrush}" /></Style>
  </UserControl.Styles>
  <UserControl.Resources>
        <DataTemplate x:Key="FileTrackTemplate" x:DataType="viewModels:TrackViewModel">
          <Border Classes="card trackCard" Classes.excluded="{Binding IsExcluded}" Padding="10" Margin="0,3">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Classes="trackMetadata" Spacing="3">
                <WrapPanel>
                  <TextBlock Text="{Binding KindText}" FontWeight="SemiBold" Margin="0,0,8,0" />
                  <TextBlock Text="{Binding Localization[TrackId]}" Margin="0,0,4,0" />
                  <TextBlock Text="{Binding IdentifierText}" Margin="0,0,8,0" />
                  <TextBlock Text="{Binding Track.Codec}" Margin="0,0,8,0" />
                  <TextBlock Text="{Binding LanguageText}" />
                </WrapPanel>
                <TextBlock Text="{Binding TitleText}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding FlagsText}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding SizeText}" Classes="muted" ToolTip.Tip="{Binding Localization[TrackSizeHelp]}" />
                <WrapPanel IsVisible="{Binding IsAudio}">
                  <TextBlock Text="{Binding Localization[Channels]}" Margin="0,0,4,0" />
                  <TextBlock Text="{Binding ChannelsText}" />
                </WrapPanel>
                <TextBlock x:Name="FileTrackSelectionState" Text="{Binding SelectionStateText}" Classes="muted" TextWrapping="Wrap" />
              </StackPanel>
              <views:TrackSelectionActionView Grid.Column="1" IsVisible="{Binding !IsRequired}" VerticalAlignment="Top"
                  Command="{Binding ToggleSelectionCommand}" IsRestore="{Binding IsExcluded}" Text="{Binding SelectionActionText}"
                  AccessibleName="{Binding SelectionActionAccessibleName}" />
              <PathIcon Grid.Column="1" Width="14" Height="17" Margin="10" VerticalAlignment="Top" IsVisible="{Binding IsRequired}"
                        Data="M3,7 L3,4 C3,0 11,0 11,4 L11,7 L13,7 L13,16 L1,16 L1,7 Z M5,7 L9,7 L9,4 C9,2 5,2 5,4 Z" />
            </Grid>
          </Border>
        </DataTemplate>
  </UserControl.Resources>
  <StackPanel Spacing="8">
    <Expander x:Name="FileVideoSection" Header="{Binding VideoSummaryText}" IsVisible="{Binding ShowVideoSection}" IsExpanded="False" HorizontalContentAlignment="Stretch">
      <ItemsControl x:Name="FileVideoTracks" ItemsSource="{Binding VideoTracks}" ItemTemplate="{StaticResource FileTrackTemplate}" />
    </Expander>
    <TabControl x:Name="FileTrackCategories" Classes="trackCategories" SelectedIndex="{Binding SelectedTrackTab, Mode=TwoWay}">
      <TabItem Header="{Binding Localization[Audio]}">
        <ItemsControl x:Name="FileTrackList" ItemsSource="{Binding AudioTracks}" IsEnabled="{Binding CanEditPlan}" ItemTemplate="{StaticResource FileTrackTemplate}" />
      </TabItem>
      <TabItem Header="{Binding Localization[Subtitles]}">
        <ItemsControl x:Name="FileSubtitleTracks" ItemsSource="{Binding SubtitleTracks}" IsEnabled="{Binding CanEditPlan}" ItemTemplate="{StaticResource FileTrackTemplate}" />
      </TabItem>
    </TabControl>
    <CheckBox x:Name="FileZeroAudioConfirmation" IsChecked="{Binding ZeroAudioConfirmed, Mode=TwoWay}" IsVisible="{Binding NeedsZeroAudioConfirmation}" IsEnabled="{Binding CanEditPlan}">
      <TextBlock Text="{Binding Localization[ConfirmSilent]}" TextWrapping="Wrap" />
    </CheckBox>
    <TextBlock Text="{Binding PlanTracksText}" TextWrapping="Wrap" IsVisible="{Binding HasPlan}" />
    <TextBlock Text="{Binding PlanDefaultAudioText}" TextWrapping="Wrap" IsVisible="{Binding HasPlan}" />
    <TextBlock Text="{Binding Localization[SelectionWarning]}" TextWrapping="Wrap" IsVisible="{Binding RemovesDefaultAudio}" />
  </StackPanel>
</UserControl>
